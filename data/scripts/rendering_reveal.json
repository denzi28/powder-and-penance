{
  "id": "rendering_reveal",
  "steps": [
    {"bars": true},
    {"camera": "point:vats", "ticks": 70},
    {"sfx": "c_steam"},
    {"burst": "smoke", "at": [7, 4], "count": 16},
    {"burst": "smoke", "at": [13, 4], "count": 16},
    {"burst": "smoke", "at": [19, 4], "count": 16},
    {"shake": 0.15},
    {"say": "The Rendering Hall. Vats the size of houses, and the heat of them on your face like a hand."},
    {"actor": "hook", "sprite": "renderer_hook", "frame": 0, "at": [1, 2], "lift": 26, "shadow": false},
    {"move": "hook", "to": [25, 2], "ticks": 360},
    {"sfx": "c_bubble"},
    {"burst": "wax", "at": [10, 3], "count": 14},
    {"say": "On the racks by the nearest vat hang pilgrim robes. Dozens. Hundreds. Each one has a tag, and each tag has a name."},
    {"burst": "wax", "at": [16, 13], "count": 14},
    {"sfx": "c_steam"},
    {"burst": "smoke", "at": [7, 13], "count": 16},
    {"say": "Carts full going in. Carts empty going out. Tallow stacked to the rafters, stamped with the Abbey's candle."},
    {"wait": 40},
    {"remove": "hook"},
    {"say": "The Tallow in your pouch is warm. It always has been."},
    {"say": "Now you know why."},
    {"set": "works_reveal"},
    {"camera": "player", "ticks": 50},
    {"bars": false}
  ]
}
